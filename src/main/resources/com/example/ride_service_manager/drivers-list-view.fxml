<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="50.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ride_service_manager.DriversListController">
   <HBox alignment="CENTER" styleClass="branding-side">
      <children>
          <Label text="Drivers List" textFill="WHITE" HBox.hgrow="ALWAYS">
            <font>
               <Font name="System Bold" size="36.0" />
            </font>
         </Label>
      </children>
      <padding>
         <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
      </padding>
   </HBox>
   <ScrollPane prefHeight="200.0" prefWidth="200.0">
      <content>
         <VBox fx:id="vbox" />
      </content>
   </ScrollPane>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
